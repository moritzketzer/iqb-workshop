# Generated outputs
*.html
*.pdf
# Exceptions: hand-authored HTML includes (not generated by Quarto)
!_includes/*.html

# Quarto cache and files
*_cache/
*_files/
.quarto/
_freeze/site_libs/
_freeze/*/libs/
_freeze/rv/

# Images folder (large binaries — add selectively with git add -f)
# images/

# macOS
.DS_Store

# Clean theme build artifact (copied by format-resources to project root)
/mathjax-config.js

# Bibliography: references.bib is now project-scoped (only cited entries).
# The full global bib (~4MB) is never committed; pre-render extracts from it locally.

**/*.quarto_ipynb

/.luarc.json

# rv project library (installed packages — regenerate from rv.lock)
/rv/

# IDE
.vscode/

# Local simulation outputs
simulation/

# Rendered site output (CI publishes to gh-pages branch)
docs/

/.quarto/
